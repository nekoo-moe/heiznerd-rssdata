# ==========================================
# DISCORD BOT CREDENTIALS
# ==========================================
# Lấy Token và Client ID từ Discord Developer Portal: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# ==========================================
# CỨU TRUYỆN CONFIGURATION
# ==========================================
CUUTRUYEN_BASE_URL=https://cuutruyen.net
CUUTRUYEN_USERNAME=hwuysuywa
CUUTRUYEN_PASSWORD=Nguynqi48@

# Chu kỳ quét truyện mới (tính theo giây, tối thiểu 30s, khuyến nghị 120s - 300s)
POLL_INTERVAL_SECONDS=180

# Chế độ crawler: api | playwright | hybrid
CRAWLER_MODE=hybrid

# ==========================================
# DATABASE PATH
# ==========================================
DATABASE_PATH=./data/bot.sqlite

# ==========================================
# DEBUG LOGGING (true/false)
# ==========================================
DEBUG=false

